# ---------- Server ----------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
MONGODB_URI=mongodb://localhost:27017/flowpilot_ai

# ---------- Auth (Phase 2) ----------
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_only_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ---------- AWS (Phase 8 / 10) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BACKUP_BUCKET=flowpilot-ai-backups

# ---------- AI Provider (Phase 6) ----------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# ---------- Email Integration (Phase 11) ----------
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@flowpilot.ai

# ---------- WhatsApp Integration (Phase 12) ----------
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------- Logging / Rate limiting ----------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
